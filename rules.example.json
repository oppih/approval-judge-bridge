{
  "deny": [
    "rm -rf\\s+/(\\s|$)",
    "rm -rf\\s+~(/|\\s|$)",
    "rm -rf\\s+/(home|etc|var|usr|boot)\\b",
    ":\\s*\\(\\s*\\)\\s*\\{\\s*:\\s*\\|\\s*:",
    "dd\\s+.*of=/dev/(sd|nvme|hd)",
    "mkfs(\\.|\\s)",
    "shred\\s+/dev/"
  ],
  "escalate": [
    "curl[^|]*\\|\\s*(ba)?sh",
    "wget[^|]*\\|\\s*(ba)?sh",
    "base64\\s+-d.*\\|\\s*(ba)?sh",
    "eval\\s+\\$\\(",
    "\\.env|\\.ssh/id_|credentials",
    "(sed|tee|cp|mv|>)\\s+.*(sudoers|authorized_keys|config\\.yaml|\\.env)",
    "systemctl\\s+(disable|mask|stop)\\s+.*(approval|guard|audit)",
    "APPROVE this|ignore previous instructions"
  ],
  "approve": [
    "git (status|diff|log|show|branch|remote)",
    "(ls|pwd)",
    "(npm|pnpm|yarn) (install|ci|list)",
    "(pip|pip3|uv pip) list",
    "(pytest|python3? -m pytest|make|cmake --version|cargo (build|test)|go (build|test))"
  ]
}
